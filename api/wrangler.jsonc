{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homeport-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Sign-in links carry their token in the query string; keep it out of logs and traces.
    "redact_query_string": true
  },
  // Production-safe defaults. Local development overrides them in .dev.vars
  // (copy .dev.vars.example).
  "vars": {
    // "dev" enables the /dev routes and EMAIL_MODE=log. Anything else is production.
    "ENVIRONMENT": "production",
    // "log" writes sign-in links to the log instead of sending them (dev only).
    // Real email delivery comes in a later PR; until then other values return 503.
    "EMAIL_MODE": "disabled",
    // Origin used to build the links in sign-in emails and Checkout's return
    // pages. Empty means no sign-in links are sent (503) and no Checkout (500).
    "PUBLIC_BASE_URL": "",
    // Hosts a peer without credits can still reach through the gateway
    // (comma-separated), besides the API's own host from PUBLIC_BASE_URL:
    // Stripe Checkout and what its page loads. They must not offer ECH, or
    // the gateway cannot read the SNI.
    "TOPUP_HOSTNAMES": "checkout.stripe.com,js.stripe.com,api.stripe.com,hooks.stripe.com,m.stripe.network,m.stripe.com,b.stripe.com,q.stripe.com,r.stripe.com,files.stripe.com"
  },
  // Every minute: recounts the free lines in each region
  // (src/lines/regions.ts). Hourly: deletes raw usage and line events after
  // 7 days, and expired idempotency records (src/prune.ts).
  "triggers": {
    "crons": ["* * * * *", "17 * * * *"]
  },
  // Keeps `wrangler types` independent of a local .dev.vars file. Set them
  // with `wrangler secret put`, and locally in .dev.vars.
  "secrets": {
    "required": [
      // Creates Identity verification sessions and Checkout Sessions. A
      // restricted key (rk_) with write access to both is enough.
      "STRIPE_SECRET_KEY",
      // Restricted key (rk_) with read access to Identity verification results
      // and detailed results; reads document number and birth date.
      "STRIPE_IDENTITY_RESTRICTED_KEY",
      // Signing secret of the webhook endpoint (whsec_), or of `stripe listen`.
      "STRIPE_WEBHOOK_SECRET",
      // Key of the HMAC that turns a verified identity into members.identity_hash.
      // Changing it breaks the duplicate-identity check for existing members.
      "IDENTITY_HASH_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeport",
      "migrations_dir": "migrations"
    }
  ]
}
