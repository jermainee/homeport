{
  "name": "homeport-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply homeport --local",
    "seed:dev": "node scripts/seed-dev.ts",
    "stripe:listen": "stripe listen --forward-to localhost:8787/v1/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,identity.verification_session.verified,identity.verification_session.processing,identity.verification_session.requires_input,identity.verification_session.canceled"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "@homeport/contracts": "file:../contracts",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
